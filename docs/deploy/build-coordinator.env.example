# Every value here is this instance's own. None of them has a built-in default:
# a published image must not carry one operator's workflow repo, host or
# registry namespace into another operator's cluster.

PORT=8090
BUILD_COORDINATOR_DB=/var/lib/tinycloud-build-coordinator/builds.db
BUILD_COORDINATOR_TOKEN=replace-with-oci-vault-secret

# The GitHub account whose Actions run the builds, and a PAT with `repo` scope
# on BUILD_WORKFLOW_REPO.
GITHUB_USERNAME=your-github-account
GITHUB_TOKEN=replace-with-oci-vault-secret

# The repository holding .github/workflows/build-app.yaml. Fork this repository
# and point at your fork; the workflow is dispatched into it by repository_dispatch.
BUILD_WORKFLOW_REPO=your-account/tinycloud-platform

# Where the build reports its logs and status back to. This must be reachable
# from GitHub Actions.
BUILD_COORDINATOR_PUBLIC_URL=https://tinycloud.example

# The registry path built images are pushed under.
IMAGE_PREFIX=ghcr.io/your-account
